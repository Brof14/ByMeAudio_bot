# Required: from @BotFather. Never commit the populated .env file.
BOT_TOKEN=
# Comma-separated administrator Telegram user IDs.
ADMIN_IDS=

# Transcription: ru or auto (auto-detects language).
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=2
WHISPER_CPU_THREADS=0
TRANSCRIPTION_LANGUAGE=ru

# Public Bot API getFile supports up to 20 MiB.
MAX_FILE_SIZE_MB=20
# Maximum duration of the *decoded* audio (seconds). Default: 15 minutes.
MAX_DURATION_SECONDS=900
# Total in-flight requests including the active one.
MAX_PENDING_JOBS=4
USER_COOLDOWN_SECONDS=3

# Optional for local use; Docker overrides these paths for persistent volumes.
DB_PATH=data/audio_bot.db
LOG_PATH=bot.log
