# Telegram bot token from @BotFather (required)
BOT_TOKEN=your_bot_token_here

# Telegram administrator user IDs, comma-separated
ADMIN_IDS=123456789,987654321

# Whisper model: tiny (faster) or base (more accurate)
WHISPER_MODEL=base

# Beam size: 1 (fastest) or 3/5 (more accurate)
WHISPER_BEAM_SIZE=1

# CPU threads: 0 means automatic detection
WHISPER_CPU_THREADS=0
